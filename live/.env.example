# Copy to live/.env (gitignored) and fill in.
# Use a dedicated MyJDownloader test account, not your personal one:
# the JDownloader containers register as devices on this account.
JD_EMAIL=
JD_PASSWORD=

# Long-lived access token of the local test Home Assistant (created after onboarding).
HA_TOKEN=

# Optional: Home Assistant version to run, defaults to 2026.9.3.
# HA_VERSION=2026.8.3
